{
  "name": "vollar-pos",
  "version": "2.0.38",
  "description": "Vollar POS â€” Caisse pour magasin",
  "main": "electron/main.js",
  "author": "Vollar",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node tools/build-release.js",
    "release": "node tools/publish-release.js",
    "dist:source": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^4.2.2"
  },
  "build": {
    "appId": "com.vollar.pos",
    "productName": "Vollar POS",
    "artifactName": "Vollar-POS-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "index.html",
      "icon.svg",
      "style.css",
      "classic-pos.css",
      "modern-enhancements.css",
      "modern-views.css",
      "js/**/*",
      "electron/main.js",
      "electron/preload.js"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "akerm1",
      "repo": "vollar"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vollar POS"
    },
    "portable": {
      "artifactName": "${productName}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
